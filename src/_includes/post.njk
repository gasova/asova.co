---
layout: base.njk
---
<article itemscope itemtype="https://schema.org/Article">
  <div class="post-header reveal">
    {% include "hero-bg.njk" %}
    <div class="container">
      <p class="eyebrow"><a href="/">← Tüm yazılar</a></p>
      <h1 itemprop="headline">{{ title }}</h1>
      <div class="post-meta">
        <span itemprop="author" itemscope itemtype="https://schema.org/Person">
          <span itemprop="name">{{ site.author }}</span>
        </span>
        <span class="dot-sep">·</span>
        <time datetime="{{ date | htmlDateString }}" itemprop="datePublished">{{ date | postDate }}</time>
        <span class="dot-sep">·</span>
        <span>{{ content | readingTime }} dk okuma</span>
        {% if tags %}
        <span class="dot-sep">·</span>
        <span class="post-tags">
          {% for tag in tags %}{% if tag != "posts" %}<a href="/etiketler/{{ tag }}/" class="post-tag">{{ tag }}</a>{% endif %}{% endfor %}
        </span>
        {% endif %}
      </div>
      <button class="print-btn no-print" onclick="window.print()" aria-label="Yazdırılabilir sürümü aç">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
        Yazdırılabilir sürüm
      </button>
    </div>
  </div>
  <div class="post-body container" itemprop="articleBody">
    {{ content | safe }}
  </div>
</article>
